<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions required for cloning and core functionality -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".CloneApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_background"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_background"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloneApp">

        <!-- Splash Screen (Main Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.CloneApp.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustPan" />

        <!-- App Selection Screen -->
        <activity
            android:name=".activities.AppSelectActivity"
            android:exported="false"
            android:label="@string/title_select_app"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Clone Detail Screen -->
        <activity
            android:name=".activities.CloneDetailActivity"
            android:exported="false"
            android:label="@string/title_clone_detail"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Device Privacy Screen -->
        <activity
            android:name=".activities.DevicePrivacyActivity"
            android:exported="false"
            android:label="@string/title_device_privacy"
            android:parentActivityName=".activities.CloneDetailActivity" />

        <!-- Fake GPS Screen -->
        <activity
            android:name=".activities.GpsSettingActivity"
            android:exported="false"
            android:label="@string/title_fake_gps"
            android:parentActivityName=".activities.CloneDetailActivity" />

        <!-- Privacy Space Authentication -->
        <activity
            android:name=".activities.PrivacySpaceAuthActivity"
            android:exported="false"
            android:label="@string/title_privacy_auth"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!-- Privacy Space Screen -->
        <activity
            android:name=".activities.PrivacySpaceActivity"
            android:exported="false"
            android:label="@string/title_privacy_space"
            android:parentActivityName=".activities.MainActivity" />

        <!-- VIP Membership Screen -->
        <activity
            android:name=".activities.VipActivity"
            android:exported="false"
            android:label="@string/title_vip"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Settings Screen -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings"
            android:parentActivityName=".activities.MainActivity" />

        <!-- About Screen -->
        <activity
            android:name=".activities.AboutActivity"
            android:exported="false"
            android:label="@string/title_about"
            android:parentActivityName=".activities.MainActivity" />

        <!-- Web View Screen -->
        <activity
            android:name=".activities.WebViewActivity"
            android:exported="false"
            android:label="@string/title_webview" />

    </application>

</manifest>
